rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App personal de un solo usuario: SOLO la cuenta autorizada puede leer/escribir.
    // CAMBIA el correo por el de quien va a usar esta copia (debe ser el mismo que
    // ALLOWED_EMAIL en index.html) y publica las reglas en la consola de Firebase.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'TU_CORREO@ejemplo.com';
    }
  }
}
